# Label Studio Configurations
LABEL_STUDIO_API_KEY=YOUR_LABEL_STUDIO_API_KEY_HERE
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_PROJECT_ID=1

# Loki Cloud Logging Configurations
LOKI_ENABLED=false
LOKI_URL=https://logs-prod-020.grafana.net/loki/api/v1/push
LOKI_USER=YOUR_GRAFANA_LOKI_USER_ID
LOKI_PASSWORD=YOUR_GRAFANA_LOKI_PASSWORD_OR_TOKEN

# MinIO Public Endpoint (Public IP of Azure VM on port 9000 for image rendering in Label Studio)
MINIO_PUBLIC_ENDPOINT=localhost:9000
